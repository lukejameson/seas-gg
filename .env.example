# GitHub Container Registry owner (your GitHub username or org, e.g. crazeddog)
# Required on the VPS so docker-compose.prod.yml can resolve image names
GITHUB_REPOSITORY_OWNER=

# Database Configuration
DATABASE_URL=postgresql://dev:devpass@localhost:5432/tides

# Tide Scraper Configuration
# URL to scrape tide data from (Guernsey tide tables)
TIDE_URL="https://tides.digimap.gg"


# Sea Temperature Scraper Configuration
# URL to scrape sea temperature from
SEA_TEMP_URL="https://www.gov.je/weather/shipping/"


# Optional: Scraper Intervals (in minutes)
# TIDE_SCRAPER_INTERVAL_MINUTES=60
# SEA_TEMP_SCRAPER_INTERVAL_MINUTES=30
# WEATHER_SERVICE_INTERVAL_MINUTES=15

# Optional: Days to scrape ahead
# TIDE_SCRAPER_DAYS_AHEAD=30
# WEATHER_SERVICE_DAYS_AHEAD=7
